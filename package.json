{
  "name": "job-application-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names client,server --prefix-colors cyan,magenta --kill-others-on-fail \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client --",
    "preview": "npm run preview --workspace client --",
    "start": "npm start --workspace server --",
    "test": "npm test --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
