# Copy to server/.env and fill in. The server reads server/.env when it starts,
# and refuses to start without MONGODB_URI and SESSION_SECRET.

# Development uses its own database, separate from production.
MONGODB_URI=mongodb://127.0.0.1:27017/job-tracker-dev

# A long random string, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# development or production. Only production serves the built client.
NODE_ENV=development

# Keep 3000 in development: the Vite dev server forwards /api to that port.
PORT=3000
