# Copy to server/.env and fill in. The server reads server/.env when it starts,
# and refuses to start without MONGODB_URI and SESSION_SECRET. Never commit the
# real values.

# Development uses its own Atlas database and database user, separate from
# production. Replace every <placeholder>; URL-encode special characters in the
# password.
MONGODB_URI=mongodb+srv://<dev-user>:<password>@<cluster-host>.mongodb.net/job-tracker-dev?retryWrites=true&w=majority

# A long random string, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Use a different one from production.
SESSION_SECRET=

# development or production. Only production serves the built client.
NODE_ENV=development

# Keep 3000 in development: the Vite dev server forwards /api to that port.
PORT=3000
